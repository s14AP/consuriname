# Kopieer naar .env en vul de waarden in. Commit .env nooit.

# Lange willekeurige string, bv. via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

DATABASE_URI=file:./consulaat.db

# Alleen nodig voor `npm run seed` wanneer er nog geen gebruikers bestaan
SEED_ADMIN_EMAIL=admin@consulaat.nl
SEED_ADMIN_PASSWORD=
